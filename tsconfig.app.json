{
    "extends": "./tsconfig.json",
    "include": ["resources/js/**/*.d.ts", "resources/js/**/*", "resources/js/**/*.vue"],
    "exclude": ["resources/js/**/__tests__/*", "node_modules", "vendor", "nativephp", "public"],
    "compilerOptions": {
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
        "paths": {
            "@/*": ["./resources/js/*"]
        }
    }
}
